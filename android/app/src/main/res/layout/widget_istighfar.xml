<?xml version="1.0" encoding="utf-8" ?>
<!--
  Home-screen widget layout.

  RemoteViews only supports a limited view set, so this is a flat, simple tree:
  a rounded card with the count, goal progress, streak and a +1 button.

  Sizes: mode is "approximately" so the same layout serves every host size;
  the percentage row and footer wrap naturally rather than swapping layouts.
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="14dp"
  android:background="@drawable/widget_background"
  android:theme="@style/Theme.IstighfarWidget"
>

    <!-- Header: label + tap target -->
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
  >

        <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/widget_label"
      android:textColor="@color/widgetTextDim"
      android:textSize="11sp"
      android:letterSpacing="0.14"
      android:maxLines="1"
    />

        <TextView
      android:id="@+id/widget_percent"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="0%"
      android:textColor="@color/widgetAccent"
      android:textSize="12sp"
      android:textStyle="bold"
      android:maxLines="1"
    />
    </LinearLayout>

    <!-- Big count -->
    <TextView
    android:id="@+id/widget_count"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:text="0"
    android:textColor="@color/widgetText"
    android:textSize="38sp"
    android:textStyle="bold"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:ellipsize="end"
  />

    <!-- Goal progress -->
    <ProgressBar
    android:id="@+id/widget_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/widget_progress"
  />

    <!-- Footer: goal + streak, and the +1 action -->
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="10dp"
  >

        <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
    >

            <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Goal 1,000"
        android:textColor="@color/widgetTextDim"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
      />

            <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 day streak"
        android:textColor="@color/widgetTextDim"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
      />
        </LinearLayout>

        <TextView
      android:id="@+id/widget_tap"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:paddingTop="7dp"
      android:paddingBottom="7dp"
      android:background="@drawable/widget_tap_button"
      android:text="+1"
      android:contentDescription="@string/widget_tap_plus_one"
      android:textColor="@color/widgetBgDeep"
      android:textSize="13sp"
      android:textStyle="bold"
      android:maxLines="1"
    />
    </LinearLayout>

    <!-- Lifetime total is only meaningful once there is data; kept subtle. -->
    <TextView
    android:id="@+id/widget_lifetime"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="0 lifetime"
    android:textColor="@color/widgetTextDim"
    android:textSize="9sp"
    android:maxLines="1"
    android:ellipsize="end"
  />
</LinearLayout>
